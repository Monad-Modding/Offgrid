{
  "required": true,
  "minVersion": "0.8",
  "package": "dev.tazer.offgrid.forge.mixin",
  "plugin": "${mixin_plugin}",
  "compatibilityLevel": "JAVA_17",
  "mixins": [
    "FireBlockMixin",
    "compat.gallery.GalleryEventsMixin"
  ],
  "client": [
    "BlockRenderDispatcherMixin",
    "compat.embeddium.BlockOcclusionCacheMixin",
    "compat.embeddium.BlockRendererMixin",
    "compat.embeddium.WorldSliceMixin",
    "ParticleEngineMixin",
    "RebuildTaskMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  }
}
